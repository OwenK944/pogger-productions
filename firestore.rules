rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'owen.klea@gmail.com';
    }
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'owen.klea@gmail.com';
    }
  }
}
